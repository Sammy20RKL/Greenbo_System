@model AspnetCoreMvcFull.Models.WorkOrderStepEffort

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">@((Model.EffortId == 0) ? "Create Step Effort" : "Edit Step Effort")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="stepForm">
    <div class="modal-body">

        <input type="hidden" asp-for="EffortId" />

        <!-- Operation -->
        <div class="mb-2">
            <label>Operation</label>
            <div class="input-group">
                <input asp-for="OperationId" class="form-control" readonly required/>
                <button type="button" class="btn btn-secondary" onclick="$('#operationModal').modal('show')">Select</button>
            </div>
        </div>

        <!-- Machine -->
        <div class="mb-2">
            <label>Machine</label>
            <div class="input-group">
                <input asp-for="MachineId" id="MachineId" class="form-control" readonly required />
                <button type="button" class="btn btn-secondary" onclick="$('#machineModal').modal('show')">Select</button>
            </div>
        </div>

        <!-- Operator -->
        <div class="mb-2">
            <label>Operator</label>
            <div class="input-group">
                <input asp-for="OperatorId" class="form-control" readonly required/>
                <button type="button" class="btn btn-secondary" onclick="$('#operatorModal').modal('show')">Select</button>
            </div>
        </div>

        <!-- Other Fields -->
        <div class="row mb-2">
            <div class="col">
                <label>Quantity Assigned</label>
                <input asp-for="QuantityAssigned" class="form-control" required />
            </div>
            <div class="col">
                <label>Quantity Completed</label>
                <input asp-for="QuantityCompleted" class="form-control" />
            </div>
        </div>

        <div class="mb-2">
            <label>Unit of Measure</label>
            <input asp-for="UnitOfMeasure" class="form-control" required/>
        </div>

        <div class="mb-2">
            <label>Expected Duration (minutes)</label>
            <input asp-for="ExpectedDuration" class="form-control" required/>
        </div>

        <div class="row mb-2">
            <div class="col">
                <label>Machine Start</label>
                <input asp-for="MachineStartTime" type="datetime-local" class="form-control" required/>
            </div>
            <div class="col">
                <label>Machine End</label>
                <input asp-for="MachineEndTime" type="datetime-local" class="form-control" />
            </div>
        </div>
    </div>

    <div class="modal-footer d-flex justify-content-center gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" onclick="saveStep()">Save</button>
    </div>
</form>

<!-- Embedded Popups -->
<!-- Operation Modal -->
<div class="modal fade" id="operationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Select Operation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Project</th>
                            <th>Part</th>
                            <th>Status</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in ViewBag.Operations as List<AspnetCoreMvcFull.Models.OrderOperation>)
                        {
                            <tr>
                                <td>@op.ID</td>
                                <td>@op.ProjectID</td>
                                <td>@op.PartNumber</td>
                                <td>@op.Status</td>
                                <td>
                                    <button class="btn btn-sm btn-success" type="button"
                                            onclick="$('#OperationId').val('@op.ID'); $('#operationModal').modal('hide')">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Machine Modal -->
<div class="modal fade" id="machineModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Select Machine</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Machine Name</th>
                            <th>Status</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in ViewBag.Machines as List<AspnetCoreMvcFull.Models.MachineRegistration>)
                        {
                            <tr>
                                <td>@m.ID</td>
                                <td>@m.MachineName</td>
                                <td>@m.MachineStatus</td>
                                <td>
                                    <button class="btn btn-sm btn-success" type="button"
                                            onclick="selectMachine(@m.ID)">
                                        Select
                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Operator Modal -->
<div class="modal fade" id="operatorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Select Operator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in ViewBag.Users as List<AspnetCoreMvcFull.Models.User>)
                        {
                            <tr>
                                <td>@u.ID</td>
                                <td>@u.Name</td>
                                <td>
                                    <button class="btn btn-sm btn-success" type="button"
                                            onclick="$('#OperatorId').val('@u.ID'); $('#operatorModal').modal('hide')">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function saveStep() {
        $.ajax({
            url: "/WorkOrderStep/CreateEditStep",
            method: "POST",
            data: $("#stepForm").serialize(),
            success: function (res) {
                if (res.success) {
                    $("#stepModal").modal("hide");
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            },
            error: function () {
                alert("An unexpected error occurred.");
            }
        });
    }
</script>
