@model AspnetCoreMvcFull.Models.MachineAllocation

<div class="modal-header">
    <h5 class="modal-title">Machine Allocation Details</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <div class="mb-3"><label>Machine:</label><input class="form-control" value="@Model.Machine?.MachineName" readonly /></div>
    <div class="mb-3"><label>Project:</label><input class="form-control" value="@Model.Project?.ProjectName" readonly /></div>
    <div class="mb-3"><label>User:</label><input class="form-control" value="@Model.UserID" readonly /></div>
    <div class="mb-3"><label>Date:</label><input class="form-control" value="@Model.Datex.ToString("yyyy-MM-dd")" readonly /></div>
</div>

<div class="modal-footer d-flex justify-content-center">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
