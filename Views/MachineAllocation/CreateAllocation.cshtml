@model AspnetCoreMvcFull.Models.MachineAllocation

<div class="d-flex justify-content-center mt-2">
    <div class="card shadow-sm rounded-4 p-4 bg-white" style="max-width:700px; width:100%;">
        <h3 class="mb-4 text-center">@((Model.ID == 0) ? "Allocate New Machine" : "Edit Allocation")</h3>

        <form id="allocationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ID" />

            <!-- MACHINE - NOW WITH SELECT2 -->
            <div class="mb-3">
                <label class="form-label">Select Machine</label>
                <select asp-for="MachineID" class="form-control" id="machineSelect" required>
                    <option value="">-- Select Machine --</option>
                </select>
            </div>

            <!-- PROJECT - NOW WITH SELECT2 -->
            <div class="mb-3">
                <label class="form-label">Select Project</label>
                <select asp-for="ProjectID" class="form-control" id="projectSelect" required>
                    <option value="">-- Select Project --</option>
                </select>
            </div>

            <!-- USER - SEARCHABLE DROPDOWN -->
            <div class="mb-3">
                <label asp-for="UserID" class="form-label">User</label>
                <select asp-for="UserID" class="form-control" id="userSelect" required>
                    <option value="">-- Select User --</option>
                </select>
            </div>

            <!-- DATE -->
            <div class="mb-3">
                <label asp-for="Datex" class="form-label">Date</label>
                <input asp-for="Datex" type="date" class="form-control"
                       value="@Model.Datex.ToString("yyyy-MM-dd")" />
            </div>

            <div class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-primary">@((Model.ID == 0) ? "Save" : "Update")</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {

        // -----------------------------
        // 1️⃣ Initialize Select2 for Machines
        // -----------------------------
        function initMachineSelect() {
            var select = $('#machineSelect');
            if (!select.length) return;

            $.get('/MachineAllocation/GetMachines', function (machines) {
                select.empty().append(new Option('-- Select Machine --', '', false, false));

                machines.forEach(function (machine) {
                    var optionText = machine.name + ' - ' + machine.purpose;
                    select.append(new Option(optionText, machine.id, false, false));
                });

                let selectedMachine = '@Model.MachineID';
                if (selectedMachine) {
                    select.val(selectedMachine);
                }

                select.select2({
                    theme: 'bootstrap-5',
                    placeholder: '-- Select Machine --',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#createAllocationModal')
                });
            });
        }

        // -----------------------------
        // 2️⃣ Initialize Select2 for Projects
        // -----------------------------
        function initProjectSelect() {
            var select = $('#projectSelect');
            if (!select.length) return;

            $.get('/MachineAllocation/GetProjects', function (projects) {
                select.empty().append(new Option('-- Select Project --', '', false, false));

                projects.forEach(function (project) {
                    var optionText = project.name + ' (' + project.company + ')';
                    select.append(new Option(optionText, project.id, false, false));
                });

                let selectedProject = '@Model.ProjectID';
                if (selectedProject) {
                    select.val(selectedProject);
                }

                select.select2({
                    theme: 'bootstrap-5',
                    placeholder: '-- Select Project --',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#createAllocationModal')
                });
            });
        }

        // -----------------------------
        // 3️⃣ Initialize Select2 for Users
        // -----------------------------
        function initUserSelect() {
            var select = $('#userSelect');
            if (!select.length) return;

            $.get('/MachineAllocation/GetUsers', function (users) {
                select.empty().append(new Option('-- Select User --', '', false, false));

                users.forEach(function (user) {
                    select.append(new Option(user.name, user.id, false, false));
                });

                let selectedUser = '@Model.UserID';
                if (selectedUser) {
                    select.val(selectedUser);
                }

                select.select2({
                    theme: 'bootstrap-5',
                    placeholder: '-- Select User --',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#createAllocationModal')
                });
            });
        }

        // Initialize all dropdowns
        initMachineSelect();
        initProjectSelect();
        initUserSelect();

        // -----------------------------
        // 4️⃣ AJAX Save Create/Edit
        // -----------------------------
        $('#allocationForm').on('submit', function (e) {
            e.preventDefault();

            var form = $(this);
            var url = '@(Model.ID == 0 ? Url.Action("CreateAllocation") : Url.Action("EditAllocation"))';

            $.ajax({
                type: "POST",
                url: url,
                data: form.serialize(),

                success: function (response) {
                    if (response.success) {
                        $('#createAllocationModal').modal('hide');

                        $('<div class="alert alert-success alert-dismissible fade show mt-2" role="alert">' +
                            response.message +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                            '</div>').prependTo('.card');

                        // Reload the entire page to refresh the table
                        setTimeout(function() {
                            window.location.reload();
                        }, 1000);
                    } else {
                        $('#createAllocationModal .modal-content').html(response);
                    }
                },
                error: function() {
                    alert('An error occurred. Please try again.');
                }
            });
        });
    });
</script>
