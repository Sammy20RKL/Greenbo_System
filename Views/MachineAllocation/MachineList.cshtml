@model IEnumerable<AspnetCoreMvcFull.Models.MachineRegistration>

<div class="modal-header">
    <h5 class="modal-title">Select Machine</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <input type="text" id="machineSearchInput" class="form-control" placeholder="🔍 Search machines..." />
    </div>
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-hover">
            <thead class="table-light sticky-top">
                <tr>
                    <th>Machine Name</th>
                    <th>Machine Purpose</th>
                </tr>
            </thead>
            <tbody id="machineTableBody">
                @foreach (var machine in Model)
                {
                    <tr class="machine-row" style="cursor: pointer;"
                        data-id="@machine.ID"
                        data-name="@machine.MachineName"
                        onclick="selectMachine(@machine.ID, '@machine.MachineName')">
                        <td>@machine.MachineName</td>
                        <td>@machine.MachinePurpose</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Real-time search functionality
        $('#machineSearchInput').on('keyup', function() {
            var searchValue = $(this).val().toLowerCase();

            $('#machineTableBody tr').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(searchValue) > -1);
            });
        });

        // Highlight row on hover
        $('.machine-row').hover(
            function() { $(this).addClass('table-active'); },
            function() { $(this).removeClass('table-active'); }
        );
    });
</script>
