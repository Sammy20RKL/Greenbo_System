@model AspnetCoreMvcFull.Models.Company
@{
    ViewData["Title"] = "View Customer";
    var existingProjects = ViewBag.Projects as List<AspnetCoreMvcFull.Models.Project> ?? new List<AspnetCoreMvcFull.Models.Project>();
}

<style>
    #projectsTable thead th {
        color: white;
        background-color: #198754;
    }

    .existing-project-row {
        background-color: #f8f9fa;
    }

    .new-project-row {
        background-color: white;
    }
</style>

<h3 class="mb-4">View Customer Details</h3>

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <strong>✓ Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>✗ Error!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Validation Errors -->
@if (!ViewData.ModelState.IsValid)
{
    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(msg => !string.IsNullOrWhiteSpace(msg))
        .ToList();

    if (errors.Any())
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong> Please correct the following:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
}

<!-- Company Information Card (Read-Only) -->
<div class="card shadow-sm rounded-4 p-4 mb-4" style="background-color: white;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold">Customer Information</h5>
        <div>
            <a asp-action="CompanyInformation" asp-controller="Company" class="btn btn-secondary btn-sm">← Back to List</a>
            <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-danger btn-sm"
               onclick="return confirm('Are you sure you want to delete this customer and all its projects?');">Delete Customer</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">Company Name</label>
            <input value="@(Model.CompanyName ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Registration Number</label>
            <input value="@(Model.RegistrationNumber ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">KRA PIN</label>
            <input value="@(Model.KraPin ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Contact Address</label>
            <input value="@(Model.ContactAddress ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Designation</label>
            <input value="@(Model.Designation ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Phone Number</label>
            <input value="@(Model.PhoneNumber ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Email</label>
            <input value="@(Model.Email ?? "")" class="form-control bg-light" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Status</label>
            <input value="@(Model.Status == true? "Active" : "Inactive")" class="form-control bg-light" readonly />
        </div>
        
        
    </div>
</div>

<!-- Projects Section -->
<form asp-action="AddProjects" asp-controller="Company" method="post" enctype="multipart/form-data" id="projectsForm">
    <input type="hidden" name="companyId" value="@Model.ID" />

    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold">Projects</h5>
            <button type="button" class="btn btn-success btn-sm" id="addProjectRow">➕ Add New Project</button>
        </div>

        <table class="table table-bordered align-middle" id="projectsTable">
            <thead style="background-color: #198754; color:white;">
                <tr>
                    <th>Project Name</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>File</th>
                    <th>Created Date</th>
                    <th style="width: 60px;">Action</th>

                </tr>
            </thead>
            <tbody id="existingProjectsBody">
                @if (existingProjects.Any())
                {
                    foreach (var project in existingProjects)
                    {
                        <tr class="existing-project-row">
                            <td>@(project.ProjectName ?? "-")</td>
                            <td>@(project.Quantity?.ToString() ?? "-")</td>
                            <td>
                                <span class="badge bg-@(
                                      project.Status == "Approved" ? "success" :
                                      project.Status == "Pending" ? "warning" : "secondary"
                                                                )">
                            @(project.Status ?? "-")

                        </span>
                    </td>
                   
                            
                    <td>
                        @if (!string.IsNullOrEmpty(project.FileUpload))
                                {
                                    <a href="@project.FileUpload" target="_blank" class="btn btn-sm btn-outline-primary">📎 Download</a>
                                }
                                else
                                {
                                    <span class="text-muted">No file</span>
                                }
                            </td>
                            <td>@(project.CreatedAt?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td class="text-center">
                                <a asp-controller="ProjectDesign"
                                   asp-action="CreateFromProject"
                                   asp-route-id="@project.ID"
                                   class="btn btn-sm btn-primary">
                                    Convert
                                </a>
                            </td>
                            
                           
                        </tr>
                    }
                }
                else
                {
                    <tr id="noProjectsRow">
                        <td colspan="6" class="text-center text-muted fst-italic">No existing projects for this company</td>
                    </tr>
                }
            </tbody>
            <tbody id="newProjectsBody">
                <!-- New projects will be added here dynamically -->
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center align-items-center gap-2">
        <button type="submit" class="btn btn-primary" id="saveNewProjectsBtn">Save New Projects</button>
        <a asp-action="CompanyInformation" asp-controller="Company" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        window.onload = function() {
            let projectIndex = 0;
            let confirmationGiven = false;

            const addBtn = document.getElementById('addProjectRow');
            const newProjectsBody = document.getElementById('newProjectsBody');
            const projectsForm = document.getElementById('projectsForm');
            const noProjectsRow = document.getElementById('noProjectsRow');

            // Add new project row
            addBtn.addEventListener('click', function () {
                const row = document.createElement('tr');
                row.classList.add('new-project-row');
                row.innerHTML = `
                    <td><input name="NewProjects[${projectIndex}].ProjectName" class="form-control bg-white text-dark" placeholder="Enter project name" /></td>
                    <td><input type="number" min="1" name="NewProjects[${projectIndex}].Quantity" class="form-control bg-white text-dark" placeholder="0" /></td>
                    <td>
                        <select name="NewProjects[${projectIndex}].Status" class="form-select bg-white text-dark">
                            <option value="New" selected>New</option>
                            <option value="Approved">Approved</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </td>
                    <td><input type="file" name="NewProjects[${projectIndex}].FileUpload" class="form-control bg-white text-dark" /></td>
                    <td class="text-center text-muted">—</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm delete-row-btn">✕</button>
                    </td>
                `;
                newProjectsBody.appendChild(row);
                projectIndex++;

                // Remove "no projects" message if it exists
                if (noProjectsRow) {
                    noProjectsRow.remove();
                }
            });

            // Delete new project row
            newProjectsBody.addEventListener('click', function(e) {
                if (e.target.classList.contains('delete-row-btn')) {
                    if (confirm('Are you sure you want to remove this project row?')) {
                        e.target.closest('tr').remove();
                    }
                }
            });

            // Form submission with confirmation
            projectsForm.addEventListener('submit', function(e) {
                // Remove empty project rows before submission
                const rows = newProjectsBody.querySelectorAll('tr');
                let hasValidRows = false;

                rows.forEach(row => {
                    const name = row.querySelector('input[name*="ProjectName"]');
                    const qty = row.querySelector('input[name*="Quantity"]');

                    if (name && qty) {
                        if (!name.value.trim() || !qty.value.trim() || qty.value <= 0) {
                            row.remove();
                        } else {
                            hasValidRows = true;
                        }
                    }
                });

                // Check if there are any valid new projects to save
                if (!hasValidRows) {
                    e.preventDefault();
                    alert('Please add at least one new project before saving!');
                    return false;
                }

                if (!confirmationGiven) {
                    e.preventDefault();
                    if (confirm('Are you sure you want to save these new projects?')) {
                        confirmationGiven = true;
                        projectsForm.submit();
                    }
                }
            });

            // Auto-dismiss success alerts after 5 seconds
            const successAlert = document.getElementById('successAlert');
            if (successAlert) {
                setTimeout(function() {
                    const bsAlert = new bootstrap.Alert(successAlert);
                    bsAlert.close();
                }, 5000);
            }
        }
    </script>
}
