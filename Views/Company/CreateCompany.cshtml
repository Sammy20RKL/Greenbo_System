@model AspnetCoreMvcFull.Models.Company
<style>
    #projectsTable thead th {
        color: white;
        background-color: #198754;
    }
</style>

@{
    ViewData["Title"] = "Create Customer";
}

<h3 class="mb-4">Create New Customer</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" asp-controller="Company" method="post" enctype="multipart/form-data" id="companyForm">
    <div class="card shadow-sm rounded-4 p-4 mb-4" style="background-color: white;">
        <h5 class="fw-bold mb-3">Customer Information</h5>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">Company Name</label>
                <input asp-for="CompanyName" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="RegistrationNumber" class="form-label">Registration Number</label>
                <input asp-for="RegistrationNumber" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="KraPin" class="form-label">KRA PIN</label>
                <input asp-for="KraPin" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="ContactAddress" class="form-label">Contact Address</label>
                <input asp-for="ContactAddress" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Designation" class="form-label">Designation</label>
                <input asp-for="Designation" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control bg-white text-dark" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control bg-white text-dark" type="email" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select bg-white text-dark">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold">Projects</h5>
            <button type="button" class="btn btn-success btn-sm" id="addProjectRow">Add Project</button>
        </div>

        <table class="table table-bordered align-middle" id="projectsTable">
            <thead style="background-color: #198754; color:white;">
                <tr>
                    <th>Project Name</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>File Upload</th>
                    <th style="width: 60px;">Remove</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center gap-2">
        <button type="submit" class="btn btn-primary" id="saveBtn">Save</button>
        <a asp-action="CompanyInformation" asp-controller="Company" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <script>

                window.onload = function() {
            let projectIndex = 0;

            const addBtn = document.getElementById('addProjectRow');
            const tbody = document.querySelector('#projectsTable tbody');
            const companyForm = document.getElementById('companyForm');
            const saveBtn = document.getElementById('saveBtn');

            // Add new project row
            addBtn.addEventListener('click', function () {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><input name="Projects[${projectIndex}].ProjectName" class="form-control bg-white text-dark" placeholder="Enter project name" /></td>
                    <td><input type="number" min="1" name="Projects[${projectIndex}].Quantity" class="form-control bg-white text-dark" placeholder="0" /></td>
                    <td>
                        <select name="Projects[${projectIndex}].Status" class="form-select bg-white text-dark">
                            <option value="New" selected>New</option>
                            <option value="Approved">Approved</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </td>
                    <td><input type="file" name="Projects[${projectIndex}].FileUpload" class="form-control bg-white text-dark" /></td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm delete-row-btn">X</button></td>
                `;
                tbody.appendChild(row);
                projectIndex++;
            });

            // Delete project row
            tbody.addEventListener('click', function(e) {
                if (e.target.classList.contains('delete-row-btn')) {
                    if (confirm('Are you sure you want to delete this project row?')) {
                        e.target.closest('tr').remove();
                    }
                }
            });

            // Handle form submission
            companyForm.addEventListener('submit', function(e) {
                e.preventDefault();

                // Get all rows
                const rows = Array.from(tbody.querySelectorAll('tr'));

                // Filter valid rows
                const validRows = rows.filter(row => {
                    const name = row.querySelector('input[name*="ProjectName"]').value.trim();
                    const qty = row.querySelector('input[name*="Quantity"]').value.trim();
                    return name && qty && parseInt(qty) > 0;
                });

                // Check if at least one valid project exists
                if (validRows.length === 0) {
                    alert('Please add at least one project with name and quantity before saving!');
                    return false;
                }

                // Show confirmation
                if (!confirm(`Are you sure you want to save this company and ${validRows.length} project(s)?`)) {
                    return false;
                }

                // Disable button to prevent double click
                saveBtn.disabled = true;
                saveBtn.textContent = 'Saving...';

                // Remove empty rows from DOM
                rows.forEach(row => {
                    if (!validRows.includes(row)) {
                        row.remove();
                    }
                });

                // REINDEX remaining rows to be sequential (0, 1, 2, 3...)
                const remainingRows = Array.from(tbody.querySelectorAll('tr'));
                remainingRows.forEach((row, newIndex) => {
                    // Update ProjectName input
                    const nameInput = row.querySelector('input[name*="ProjectName"]');
                    nameInput.name = `Projects[${newIndex}].ProjectName`;

                    // Update Quantity input
                    const qtyInput = row.querySelector('input[name*="Quantity"]');
                    qtyInput.name = `Projects[${newIndex}].Quantity`;

                    // Update Status select
                    const statusSelect = row.querySelector('select[name*="Status"]');
                    statusSelect.name = `Projects[${newIndex}].Status`;

                    // Update FileUpload input
                    const fileInput = row.querySelector('input[type="file"]');
                    fileInput.name = `Projects[${newIndex}].FileUpload`;
                });

                // Submit form
                companyForm.submit();
            });
        }
    </script>
}
