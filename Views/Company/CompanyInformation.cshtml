@model IEnumerable<AspnetCoreMvcFull.Models.Company>

@{
    ViewData["Title"] = "Customers List";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm rounded-4 p-4 mb-4" style="background-color: #d1fae5;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1">Customers</h4>
            <p class="text-muted">Manage all customers records</p>
        </div>

        <a asp-action="Create" asp-controller="Company" class="btn btn-outline-primary rounded-pill">
            Add New Customer
        </a>
    </div>
</div>

<!-- Search Form -->
<form asp-action="CompanyInformation" asp-controller="Company" method="get" class="d-flex gap-2">
    <input type="text" name="searchTerm" class="form-control rounded-pill"
           placeholder="Search customers here..."
           value="@(Context.Request.Query["searchTerm"])" />

    <button type="submit" class="btn btn-primary rounded-pill">Search</button>
</form>

<div class="card shadow-sm rounded-4 p-4 mt-3">
    <table class="table table-hover align-middle">
        <thead style="background-color: #f3f4f6;">
            <tr>
                <th>Company Name</th>
                <th>Registration No.</th>
                <th>KRA Pin</th>
                <th>Contact Address</th>
                <th>Designation</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Created</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CompanyName</td>
                    <td>@item.RegistrationNumber</td>
                    <td>@item.KraPin</td>
                    <td>@item.ContactAddress</td>
                    <td>@item.Designation</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Status</td>
                    <td>@item.CreatedAt?.ToString("yyyy-MM-dd")</td>

                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="View" asp-controller="Company" asp-route-id="@item.ID"
                               class="btn btn-primary btn-sm">View</a>
                            <a asp-action="EditCompany" asp-controller="Company" asp-route-id="@item.ID"
                               class="btn btn-warning btn-sm">✎ Edit</a>

                            <a asp-action="Delete" asp-controller="Company" asp-route-id="@item.ID"
                               class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    table td, table th {
        vertical-align: middle;
    }

    table th, table td {
        white-space: nowrap;
    }

    table tbody tr:hover {
        background-color: #e5f4f1;
    }

    table td div.d-flex {
        height: 100%;
        align-items: center;
    }
</style>
